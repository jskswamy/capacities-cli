{
  "name": "capacities-cli",
  "version": "0.2.0",
  "description": "CLI for the Capacities REST API",
  "type": "module",
  "bin": {
    "capacities": "./dist/index.js",
    "cap": "./dist/index.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "dev": "tsx src/index.ts",
    "link-bin": "npm run build && chmod +x dist/index.js && ln -sf \"$(pwd)/dist/index.js\" \"${CAPACITIES_BIN_DIR:-$HOME/.local/bin}/capacities\" && ln -sf \"$(pwd)/dist/index.js\" \"${CAPACITIES_BIN_DIR:-$HOME/.local/bin}/cap\" && echo \"Linked to ${CAPACITIES_BIN_DIR:-$HOME/.local/bin}/{capacities,cap}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "coverage": "vitest run --coverage",
    "lint": "eslint --max-warnings=0",
    "format": "prettier --check ."
  },
  "dependencies": {
    "@capacities/api": "^1.2.0",
    "age-encryption": "^0.3.1",
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "smol-toml": "^1.3.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "libsodium-wrappers-sumo": "0.7.15",
    "minimatch": "$minimatch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@typescript-eslint/typescript-estree": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "minimatch": "^11.0.8",
    "msw": "^3.0.5",
    "openapi-backend": "^5.10.0",
    "prettier": "^3.3.0",
    "tsup": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.1.0"
  }
}
