{
  "name": "capacities-cli",
  "version": "0.1.0",
  "description": "CLI for the Capacities REST API",
  "type": "module",
  "bin": {
    "capacities": "./dist/index.js",
    "cap": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "dev": "tsx src/index.ts",
    "link-bin": "npm run build && chmod +x dist/index.js && ln -sf \"$(pwd)/dist/index.js\" \"${CAPACITIES_BIN_DIR:-$HOME/.local/bin}/capacities\" && ln -sf \"$(pwd)/dist/index.js\" \"${CAPACITIES_BIN_DIR:-$HOME/.local/bin}/cap\" && echo \"Linked to ${CAPACITIES_BIN_DIR:-$HOME/.local/bin}/{capacities,cap}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "coverage": "vitest run --coverage",
    "lint": "eslint --max-warnings=0",
    "format": "prettier --check ."
  },
  "dependencies": {
    "@capacities/api": "^1.0.1",
    "age-encryption": "^0.1.2",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "smol-toml": "^1.3.0"
  },
  "overrides": {
    "libsodium-wrappers-sumo": "0.7.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "msw": "^2.0.0",
    "openapi-backend": "^5.10.0",
    "prettier": "^3.3.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
